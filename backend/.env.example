# Supabase project URL / anon(publishable) key (둘 다 공개 정보 — U01_summary.md 참고)
SUPABASE_URL=https://imeujftiiqhbfzqvebnr.supabase.co
SUPABASE_ANON_KEY=sb_publishable_NG-kKbdUWgwoG0Lj8n5SIw_5FlCbpKo

# Supabase Auth가 발급하는 JWT의 aud(audience) 클레임. 기본값은 "authenticated".
SUPABASE_JWT_AUD=authenticated

# 브라우저 CORS 허용 origin (콤마로 여러 개 지정 가능). 기본값은 Vite 개발 서버.
CORS_ALLOW_ORIGINS=http://localhost:5173

# U05: 영상 업로드용 Supabase Storage 버킷 이름 (대시보드에서 만든 버킷 이름과 반드시 일치해야 함)
SUPABASE_VIDEOS_BUCKET=video

# U06: 백그라운드 워커 전용. 모든 사용자의 pending project를 폴링해야 해서 RLS를 우회하는
# service_role 키가 필요하다 (FastAPI 앱 자체는 이 키를 쓰지 않음 — worker.py에서만 사용).
# Supabase 대시보드 → Project Settings → API → service_role secret 에서 발급받아 채울 것.
# 절대 커밋하지 말 것 (.gitignore에 이미 .env 제외 처리됨).
SUPABASE_SERVICE_ROLE_KEY=
